// Prisma schema — Vercel Postgres + Auth.js (Prisma Adapter)
// https://www.prisma.io/docs/orm/overview/databases/postgresql
// https://authjs.dev/getting-started/adapters/prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Direct Postgres URL from Vercel Prisma Postgres integration
  url      = env("POSTGRES_URL")
}

enum Role {
  USER
  ADMIN
}

enum MarketPulseCycleStatus {
  DRAFT
  OPEN
  CLOSED
  REVEALED
  ARCHIVED
}

enum MarketPulseCardStatus {
  DRAFT
  READY
  PUBLISHED
  CLOSED
  REVEALED
}

enum MarketPulseCardType {
  SIGNAL
  REST
}

enum MarketPulseSignal {
  BULLISH
  CAUTIOUS
  /// Rest-card participation acknowledgement stored on MarketPulseDecision.
  ACKNOWLEDGED
}

enum MarketPulseLeaderboardType {
  CURRENT_CYCLE
  MONTHLY
  ALL_TIME
}

enum MarketPulsePrizeStatus {
  PENDING_REVIEW
  VERIFIED
  CONTACTED
  CLAIMED
  DISQUALIFIED
  EXPIRED
}

enum MarketPulseGameRuntimeStatus {
  OPEN
  CLOSED
  MAINTENANCE
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  contactNumber String?
  password      String?
  role          Role      @default(USER)

  accounts               Account[]
  sessions               Session[]
  gameScores             GameScore[]
  marketPulseDecisions   MarketPulseDecision[]
  marketPulseScoreEvents MarketPulseScoreEvent[]
  marketPulseScores      MarketPulseScore[]
  marketPulsePrizeClaims MarketPulsePrizeClaim[]
  marketPulseAuditLogs   MarketPulseAuditLog[]
  acquisitionProfile     UserAcquisitionProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserAcquisitionProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  learningInterest                  String?
  learningInterestCapturedAt        DateTime?
  learningInterestPromptDismissedAt DateTime?

  nextStepPreference          String?
  nextStepCapturedAt          DateTime?
  nextStepPromptDismissedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GameScore {
  id          String  @id @default(cuid())
  score       Int
  userId      String
  /// Market Pulse challenge window key, e.g. `2026-01-01_2026-01-10` (HKT).
  cycleId     String?
  /// Client/rules version at time of save (e.g. `1`).
  gameVersion String?
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([score(sort: Desc)])
  @@index([cycleId])
}

// --- Market Pulse game (Prisma-backed) ---

model MarketPulseCycle {
  id         String                 @id @default(cuid())
  name       String
  startsAt   DateTime
  endsAt     DateTime
  revealAt   DateTime
  status     MarketPulseCycleStatus @default(DRAFT)
  prizeLabel String?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  cards              MarketPulseCard[]
  decisions          MarketPulseDecision[]
  scoreEvents        MarketPulseScoreEvent[]
  scores             MarketPulseScore[]
  prizeClaims        MarketPulsePrizeClaim[]
  activeGameSettings MarketPulseGameSetting[]

  @@index([status])
  @@index([startsAt])
  @@index([endsAt])
}

model MarketPulseCard {
  id                String                @id @default(cuid())
  cycleId           String
  /// 1-based cycle calendar day (legacy rows may use 0-based). Multiple cards may share the same dayIndex; use sortOrder to order them.
  dayIndex          Int
  /// Order within a cycle day (0 = first). Together with dayIndex identifies a card slot when multiple signals run on one day.
  sortOrder         Int                   @default(0)
  cardType          MarketPulseCardType     @default(SIGNAL)
  companyName       String
  /// Traditional Chinese company name (legacy zh field — English default is companyName).
  companyNameZh     String?
  ticker            String
  exchange          String?
  logoUrl           String?
  priceLabel        String?
  priceDirection    String?
  headline          String
  /// Traditional Chinese headline; players fall back to headline when empty.
  headlineZhHant    String?
  sourceName        String?
  sourceUrl         String?
  sourceDate        DateTime?
  newsBody          String?               @db.Text
  newsBodyZhHant    String?               @db.Text
  summary           String?
  summaryZhHant     String?
  logoInitials      String?
  cardImageUrl      String?
  cardImageAlt      String?
  cardImageAltZhHant String?
  userPrompt        String?
  userPromptZhHant  String?
  ppaSignal         MarketPulseSignal?
  ppaInsight        String?
  /// Post-reveal only — never exposed in public payloads before reveal (see reveal-access.ts).
  ppaInsightZhHant  String?               @db.Text
  ppaSignalLockedAt DateTime?
  status            MarketPulseCardStatus @default(DRAFT)
  /// Legacy per-card go-live override; new workflow may derive 9:00 AM HKT from cycle + dayIndex.
  publishedAt       DateTime?
  /// Legacy per-card reveal override; defaults to cycle.revealAt when null.
  revealAt          DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  cycle       MarketPulseCycle        @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  decisions   MarketPulseDecision[]
  scoreEvents MarketPulseScoreEvent[]

  @@unique([cycleId, dayIndex, sortOrder])
  @@index([cycleId])
  @@index([cycleId, dayIndex, sortOrder])
  @@index([status])
  @@index([publishedAt])
  @@index([revealAt])
}

model MarketPulseDecision {
  id            String            @id @default(cuid())
  userId        String
  cardId        String
  cycleId       String
  decision      MarketPulseSignal
  decidedAt     DateTime          @default(now())
  ipHash        String?
  userAgentHash String?
  createdAt     DateTime          @default(now())

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  card  MarketPulseCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cycle MarketPulseCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@index([userId])
  @@index([cardId])
  @@index([cycleId])
  @@index([decidedAt])
}

model MarketPulseScoreEvent {
  id                  String   @id @default(cuid())
  userId              String
  cycleId             String
  cardId              String?
  participationPoints Int      @default(0)
  matchBonus          Int      @default(0)
  streakBonus         Int      @default(0)
  totalPoints         Int
  reason              String
  createdAt           DateTime @default(now())

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycle MarketPulseCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  card  MarketPulseCard? @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([cycleId])
  @@index([cardId])
  @@index([createdAt])
}

/// Per-user cycle aggregate written during reveal scoring (alongside score events).
model MarketPulseScore {
  id                 String   @id @default(cuid())
  userId             String
  cycleId            String
  participationScore Int      @default(0)
  decisionsSubmitted Int      @default(0)
  totalCards         Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycle MarketPulseCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([userId, cycleId])
  @@index([userId])
  @@index([cycleId])
}

model MarketPulsePrizeClaim {
  id              String                     @id @default(cuid())
  userId          String
  cycleId         String?
  leaderboardType MarketPulseLeaderboardType
  rank            Int
  prizeName       String
  status          MarketPulsePrizeStatus     @default(PENDING_REVIEW)
  verifiedAt      DateTime?
  claimedAt       DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycle MarketPulseCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([cycleId])
  @@index([leaderboardType])
  @@index([status])
}

model MarketPulseAuditLog {
  id          String   @id @default(cuid())
  adminUserId String?
  entityType  String
  entityId    String
  action      String
  fieldName   String?
  oldValue    String?
  newValue    String?
  reason      String?
  createdAt   DateTime @default(now())

  adminUser User? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([entityType])
  @@index([entityId])
  @@index([adminUserId])
  @@index([createdAt])
}

model MarketPulseGameSetting {
  id                     String                       @id @default(cuid())
  runtimeStatus          MarketPulseGameRuntimeStatus @default(OPEN)
  defaultLeaderboardMode MarketPulseLeaderboardType   @default(CURRENT_CYCLE)
  activeCycleId          String?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt

  activeCycle MarketPulseCycle? @relation(fields: [activeCycleId], references: [id], onDelete: SetNull)

  @@index([activeCycleId])
}

// --- Auth.js Prisma Adapter models ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}
